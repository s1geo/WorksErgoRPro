<Window x:Class="WorksErgo.Sandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work(s) Ergo - Standalone DHM 3D Engineering Sandbox" Height="820" Width="1240"
        Background="#181B20" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation & Mode Bar -->
        <Border Grid.Row="0" Background="#21252B" BorderBrush="#333842" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WORK(S) ERGO" Foreground="#61AFEF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" | DHM 3D Standalone Test Harness (F5 Live Debug)" Foreground="#828997" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Name="BtnStoop" Content="Stoop (T > K)" Click="BtnStoop_Click" Margin="4,0" Padding="12,5" Background="#2C313A" Foreground="#ABB2BF" BorderBrush="#3E4451"/>
                    <Button Name="BtnSemiSquat" Content="Semi-Squat (T ≈ K)" Click="BtnSemiSquat_Click" Margin="4,0" Padding="12,5" Background="#2C313A" Foreground="#98C379" BorderBrush="#3E4451"/>
                    <Button Name="BtnDeepSquat" Content="Deep Squat (K > T)" Click="BtnDeepSquat_Click" Margin="4,0" Padding="12,5" Background="#2C313A" Foreground="#E5C07B" BorderBrush="#3E4451"/>
                    <Button Name="BtnResetPose" Content="Reset Ready" Click="BtnResetPose_Click" Margin="4,0" Padding="12,5" Background="#2C313A" Foreground="#E06C75" BorderBrush="#3E4451"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body: 3D Viewport on Left, Telemetry & Controls on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: 3D Viewport -->
            <Border Grid.Column="0" Background="#0F1115" Margin="4" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Viewport3D Name="MainViewport" MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="MainCamera" Position="1200,-2200,1200" LookDirection="-1200,2200,-300" UpDirection="0,0,1" FieldOfView="45"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="SceneGroup">
                                    <DirectionalLight Color="#FFFFFF" Direction="-1,1,-1"/>
                                    <DirectionalLight Color="#555555" Direction="1,-1,-0.5"/>
                                    <AmbientLight Color="#333333"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- In-Scene 3D Overlay Help -->
                    <Border Background="#CC1E2227" CornerRadius="6" Padding="10,8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                        <StackPanel>
                            <TextBlock Text="3D CAD Interact Controls:" Foreground="#61AFEF" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="• Left Click + Drag: Orbit Camera" Foreground="#ABB2BF" FontSize="11" Margin="0,3,0,0"/>
                            <TextBlock Text="• Right Click + Drag: Pan Camera" Foreground="#ABB2BF" FontSize="11"/>
                            <TextBlock Text="• Wheel: Zoom" Foreground="#ABB2BF" FontSize="11"/>
                            <TextBlock Text="• Click Yellow Cylinder: Cycle InteliPose (Stoop/Squat)" Foreground="#E5C07B" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="• Click Blue Cylinder: Cycle Task (Lift/Push/Carry)" Foreground="#61AFEF" FontSize="11"/>
                            <TextBlock Text="• Click Pink Cylinder: Reset to Ready" Foreground="#E06C75" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Ergonomics Telemetry & Parameters -->
            <Border Grid.Column="1" Background="#1E2227" Margin="4" CornerRadius="4" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- DCR Score Banner -->
                        <Border Name="DcrCard" Background="#282C34" BorderBrush="#98C379" BorderThickness="2" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="DEMAND / CAPACITY RATIO (DCR)" Foreground="#828997" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Name="TxtDcrValue" Text="0.74" Foreground="#98C379" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4"/>
                                <TextBlock Name="TxtDcrCategory" Text="ACCEPTABLE [GREEN]" Foreground="#98C379" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Biomechanical Metrics Grid -->
                        <TextBlock Text="BIOMECHANICAL TELEMETRY" Foreground="#5C6370" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="L5/S1 Compression (NIOSH &lt; 3400 N):" Foreground="#ABB2BF" FontSize="12" Margin="0,3"/>
                            <TextBlock Name="TxtL5S1" Grid.Row="0" Grid.Column="1" Text="2450 N" Foreground="#61AFEF" FontWeight="Bold" FontSize="12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CoM Plumb Line (BoS +40..+70 mm):" Foreground="#ABB2BF" FontSize="12" Margin="0,3"/>
                            <TextBlock Name="TxtCoM" Grid.Row="1" Grid.Column="1" Text="+52.4 mm (STABLE)" Foreground="#98C379" FontWeight="Bold" FontSize="12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="RULA Action Level (1-7):" Foreground="#ABB2BF" FontSize="12" Margin="0,3"/>
                            <TextBlock Name="TxtRula" Grid.Row="2" Grid.Column="1" Text="3 (Acceptable)" Foreground="#E5C07B" FontWeight="Bold" FontSize="12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="REBA Action Level (1-15):" Foreground="#ABB2BF" FontSize="12" Margin="0,3"/>
                            <TextBlock Name="TxtReba" Grid.Row="3" Grid.Column="1" Text="4 (Medium)" Foreground="#E5C07B" FontWeight="Bold" FontSize="12"/>
                        </Grid>

                        <Separator Background="#333842" Margin="0,4,0,14"/>

                        <!-- Interactive Hand Sliders -->
                        <TextBlock Text="FLOATING HANDS INTERACTIVE TARGETS" Foreground="#5C6370" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                        <TextBlock Text="Hand Height Z (Vertical Pick/Place):" Foreground="#ABB2BF" FontSize="11"/>
                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Name="TxtHandZ" Text="750 mm" Foreground="#61AFEF" FontSize="11" DockPanel.Dock="Right" Width="55" TextAlignment="Right"/>
                            <Slider Name="SliderHandZ" Minimum="150" Maximum="1700" Value="750" ValueChanged="Slider_ValueChanged"/>
                        </DockPanel>

                        <TextBlock Text="Hand Reach X (Horizontal Reach):" Foreground="#ABB2BF" FontSize="11"/>
                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Name="TxtHandX" Text="450 mm" Foreground="#61AFEF" FontSize="11" DockPanel.Dock="Right" Width="55" TextAlignment="Right"/>
                            <Slider Name="SliderHandX" Minimum="200" Maximum="850" Value="450" ValueChanged="Slider_ValueChanged"/>
                        </DockPanel>

                        <TextBlock Text="Load Mass (kg):" Foreground="#ABB2BF" FontSize="11"/>
                        <DockPanel Margin="0,2,0,12">
                            <TextBlock Name="TxtLoadMass" Text="10.0 kg" Foreground="#61AFEF" FontSize="11" DockPanel.Dock="Right" Width="55" TextAlignment="Right"/>
                            <Slider Name="SliderLoadMass" Minimum="0" Maximum="35" Value="10" ValueChanged="Slider_ValueChanged"/>
                        </DockPanel>

                        <!-- Task & Anthropometry Selection -->
                        <TextBlock Text="ANTHROPOMETRY &amp; COUPLING" Foreground="#5C6370" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                        <TextBlock Text="Worker Percentile:" Foreground="#ABB2BF" FontSize="11"/>
                        <ComboBox Name="ComboPercentile" SelectionChanged="Combo_SelectionChanged" Background="#2C313A" Foreground="#ABB2BF" Margin="0,2,0,8">
                            <ComboBoxItem Content="Male 50th Percentile" IsSelected="True"/>
                            <ComboBoxItem Content="Male 95th Percentile"/>
                            <ComboBoxItem Content="Female 5th Percentile"/>
                            <ComboBoxItem Content="Female 50th Percentile"/>
                        </ComboBox>

                        <TextBlock Text="Task Type (Blue Cylinder):" Foreground="#ABB2BF" FontSize="11"/>
                        <ComboBox Name="ComboTaskType" SelectionChanged="Combo_SelectionChanged" Background="#2C313A" Foreground="#ABB2BF" Margin="0,2,0,8">
                            <ComboBoxItem Content="Lifting / Lowering (ISO 11228-1)" IsSelected="True"/>
                            <ComboBoxItem Content="Pushing / Pulling (ISO 11228-2)"/>
                            <ComboBoxItem Content="Carrying (Snook LM-MMH)"/>
                        </ComboBox>

                        <CheckBox Name="ChkAttachHands" Content="Attach Hands? (Follow Torso)" IsChecked="True" Foreground="#ABB2BF" Margin="0,4,0,10" Checked="ChkAttachHands_Changed" Unchecked="ChkAttachHands_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#21252B" BorderBrush="#333842" BorderThickness="0,1,0,0" Padding="14,4">
            <DockPanel>
                <TextBlock Text="Ready | Kinematics: Dempster-Winter CoM + 2-Segment IK | 60 FPS Standalone" Foreground="#5C6370" FontSize="11"/>
                <TextBlock Text="Target: net48 / R-Pro v2.2.2 Compatible" Foreground="#5C6370" FontSize="11" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
