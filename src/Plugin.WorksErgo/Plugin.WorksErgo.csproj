<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Plugin.WorksErgo</AssemblyName>
    <RootNamespace>WorksErgo</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <UseWPF>true</UseWPF>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- System and WPF Framework References -->
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Configuration" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- R-Pro v2.2.2 Native Host References (Portable via repo lib/ with local CAD fallback) -->
  <PropertyGroup>
    <RProLibDir Condition="Exists('$(MSBuildThisFileDirectory)..\..\lib\UX.Shared.dll')">$(MSBuildThisFileDirectory)..\..\lib</RProLibDir>
    <RProLibDir Condition="'$(RProLibDir)' == ''">D:\Apps\RProv222</RProLibDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UX.Shared">
      <HintPath>$(RProLibDir)\UX.Shared.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UX.Ribbon">
      <HintPath>$(RProLibDir)\UX.Ribbon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Create3D.Shared">
      <HintPath>$(RProLibDir)\Create3D.Shared.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Caliburn.Micro">
      <HintPath>$(RProLibDir)\Caliburn.Micro.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Embedded Mesh and CAD Resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

  <!-- Auto-deploy to R-Pro root for instant F5 testing -->
  <Target Name="DeployToRPro" AfterTargets="Build" Condition="Exists('D:\Apps\RProv222')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="D:\Apps\RProv222\" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="D:\Apps\RProv222\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" SkipUnchangedFiles="false" />
  </Target>

</Project>
